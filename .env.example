# 登录管理后台的密码（必填，改成你自己的）
ADMIN_PASSWORD=change-me

# 用于签名 session cookie 的随机密钥（必填，可用 `openssl rand -hex 32` 生成）
AUTH_SECRET=change-me

# 可选：以 JSON 字符串直接提供 service account（部署到 Vercel 等平台时推荐）
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# 可选：覆盖 Storage bucket 名（默认按 <project_id>.appspot.com 推导）
# FIREBASE_STORAGE_BUCKET=my-bucket
