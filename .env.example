# Password to log into the admin console (required, change it to your own)
ADMIN_PASSWORD=change-me

# Random key used to sign the session cookie (required, generate with `openssl rand -hex 32`)
AUTH_SECRET=change-me

# Optional: provide the service account as a JSON string directly
# (recommended when deploying to Vercel or similar platforms)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# Optional: override the Storage bucket name
# (defaults to <project_id>.appspot.com)
# FIREBASE_STORAGE_BUCKET=my-bucket
